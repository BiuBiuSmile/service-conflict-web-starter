# ===== 基本 =====
FRONTEND_URL=https://YOUR-WEB-DOMAIN.example
API_PUBLIC_URL=https://YOUR-API-DOMAIN.example
PORT=5001
TRIAL_LIMIT=3
TOKEN_HOURS=168

# 方案（正式上線前請自行決定價格）
PLAN_DAYS=30
PLAN_PRICE=0

# ===== 管理者初始帳號（第一次啟動時建立）=====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ===== Email 驗證 =====
# 開發可用 console，驗證網址會印在伺服器 Log。
# 正式環境改 smtp。
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# ===== 綠界 =====
# stage = 測試、production = 正式
ECPAY_MODE=stage

# 綠界官方測試環境一般特店資料（僅限測試）
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
